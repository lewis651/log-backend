DATABASE_URL=postgres://user:password@localhost:5432/logistics
PORT=5000
JWT_SECRET=your_super_secret_jwt_key
SEED_SECRET=your_seed_secret
FRONTEND_ORIGIN=http://localhost:5173

# Cloudinary (Product Image Storage - Required for uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option A: Resend (Easiest - Recommended)
RESEND_API_KEY=re_123456789
REPLY_TO=Logistiqo@gmail.com
EMAIL_FROM=Logistiqo Logistics <notifications@logistiqo.site>

# Option B: Standard SMTP / Gmail (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Logistiqo Logistics" <your_email@gmail.com>
